@model ProductDetailsModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Seo
@using Nop.Services.Html

@inject IHtmlFormatter htmlFormatter
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-product-details-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var productUrl = Url.RouteUrl<Product>(new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant();
        NopHtml.AddCanonicalUrlParts(productUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }
}

<style>
    .bulk-order-container { margin: 30px 0; overflow-x: auto; }
    .bulk-order-table { width: 100%; border-collapse: collapse; border: 1px solid #ccc; font-family: Arial, sans-serif; font-size: 14px; }
    .bulk-order-table th { background-color: #f5f5f5; color: #333; border: 1px solid #ccc; padding: 12px 10px; text-align: center; font-weight: bold; }
    .bulk-order-table td { border: 1px solid #ccc; padding: 12px 10px; text-align: center; vertical-align: middle; }
    .bulk-order-table tr:nth-child(even) { background-color: #fafafa; }
    .bulk-order-table tr:hover { background-color: #f1f5f9; }
    .bulk-sku-link { font-weight: bold; color: #0066cc !important; text-decoration: underline !important; cursor: pointer !important; display: inline-block; }
    .bulk-sku-link:hover { color: #003399 !important; }
    .bulk-qty-input { width: 65px; text-align: center; padding: 6px; border: 1px solid #bbb; border-radius: 4px; font-size: 14px; }
    .bulk-add-btn { background-color: #003366; color: #fff; border: none; padding: 7px 18px; cursor: pointer; border-radius: 4px; font-weight: bold; font-size: 13px; transition: background 0.2s; text-transform: uppercase; }
    .bulk-add-btn:hover { background-color: #001f42; }
    .bulk-tier-prices { font-size: 12px; color: #555; text-align: left; list-style: none; padding: 0; margin: 5px 0 0 0; border-top: 1px dashed #ddd; padding-top: 5px; }
</style>

@section Breadcrumb {
    @await Html.PartialAsync("_ProductBreadcrumb", Model.Breadcrumb)
}

<div class="page product-details-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsTop, additionalData = Model })
        
        <form asp-route="Product" asp-route-sename="@Model.SeName" method="post" id="product-details-form">
            
            <input type="hidden" id="hidden_entered_quantity" name="temporary_holder" value="1" />

            <div data-productid="@Model.Id">
                <div class="product-essential">
                    <div class="gallery">
                        @await Html.PartialAsync("_ProductDetailsPictures", Model)
                    </div>
                    <div class="overview">
                        <div class="product-name">
                            <h1>@Model.Name</h1>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ShortDescription))
                        {
                            <div class="short-description">
                                @Html.Raw(Model.ShortDescription)
                            </div>
                        }
                    </div>
                </div>
                
                <div class="product-collateral">
                    <div class="bulk-order-container">
                        @if (Model.AssociatedProducts.Any())
                        {
                            <table class="bulk-order-table">
                                <thead>
                                    <tr>
                                        <th style="width: 15%;">MODEL NO.</th>
                                        <th style="width: 50%; text-align: left;">DESCRIPTION / SIZE</th>
                                        <th style="width: 15%;">PRICE BREAKS</th>
                                        <th style="width: 20%;">ADD TO CART</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var variant in Model.AssociatedProducts)
                                    {
                                        <tr data-productid="@variant.Id">
                                            <td>
                                                <span class="bulk-sku-link" onclick="javascript:window.location.href='/@variant.SeName';">
                                                    @(!string.IsNullOrEmpty(variant.Sku) ? variant.Sku : "Details")
                                                </span>
                                            </td>
                                            <td style="text-align: left;">
                                                <div style="font-weight: 600; color: #333;">@variant.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(variant.ShortDescription))
                                                {
                                                    <div style="font-size:12px; color:#666; margin-top:4px; line-height: 1.4;">@Html.Raw(variant.ShortDescription)</div>
                                                }
                                            </td>
                                            <td>
                                                <div style="font-weight: bold; color: #cc0000; font-size: 15px;">
                                                    @{
                                                        var dataDictPrice = new ViewDataDictionary(ViewData);
                                                        dataDictPrice.TemplateInfo.HtmlFieldPrefix = $"price_{variant.Id}";
                                                        @await Html.PartialAsync("_ProductPrice", variant.ProductPrice, dataDictPrice)
                                                    }
                                                </div>
                                                @if (variant.TierPrices != null && variant.TierPrices.Any())
                                                {
                                                    <ul class="bulk-tier-prices">
                                                        @foreach (var tierPrice in variant.TierPrices)
                                                        {
                                                            <li>• @tierPrice.Quantity+ : <span style="color:#cc0000; font-weight:600;">@tierPrice.Price</span></li>
                                                        }
                                                    </ul>
                                                }
                                            </td>
                                            <td>
                                                <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                                    <input type="text" 
                                                           id="custom_qty_@variant.Id" 
                                                           class="bulk-qty-input" 
                                                           value="1" 
                                                           onkeyup="this.value=this.value.replace(/\D/g,'')" />
                                                    
                                                    <button type="button" 
                                                            class="bulk-add-btn" 
                                                            onclick="javascript:smartFormAddToCart(@variant.Id); return false;">
                                                        ADD
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
    function smartFormAddToCart(productId) {
        var qtyEl = document.getElementById("custom_qty_" + productId);
        var quantity = qtyEl ? qtyEl.value : "1";
        var intQty = parseInt(quantity);
        
        if (isNaN(intQty) || intQty <= 0) {
            alert("Please enter a valid quantity.");
            return false;
        }
        
        // 在前端点击的一瞬间，动态拼接单品所需要的标准字段名，完美绕过后端编译期
        var hiddenInput = document.getElementById("hidden_entered_quantity");
        if (hiddenInput) {
            hiddenInput.name = "addtocart_" + productId + ".EnteredQuantity";
            hiddenInput.value = intQty;
        }
        
        var updateUrl = "/addproducttocart/details/" + productId + "/1?quantity=" + intQty;
        
        if (typeof AjaxCart !== 'undefined' && typeof AjaxCart.addproducttocart_details === 'function') {
            AjaxCart.addproducttocart_details(updateUrl, '#product-details-form');
        } else {
            alert("Shopping cart system error, please refresh the page.");
        }
        return false;
    }
</script>